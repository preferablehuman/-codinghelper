APP_ENV=local
VERBOSE_LOGGING=false
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10

DATABASE_URL=postgresql+psycopg://explainer:explainer@postgres:5432/programming_explainer

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sources
QDRANT_PROBLEM_COLLECTION=problem_corpus
QDRANT_KNOWLEDGE_COLLECTION=knowledge_chunks

SANDBOX_RUNNER_URL=http://sandbox-runner:8100
SLIDE_RENDERER_URL=http://slide-renderer:8200

MODEL_GATEWAY_URL=http://model-gateway:8300
MODEL_GATEWAY_REQUEST_TIMEOUT_SECONDS=660
MODEL_GATEWAY_HEALTH_TIMEOUT_SECONDS=10

# Provider selection belongs only to the model-gateway service.
LLM_PROVIDER=nvidia
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# Only the block selected by LLM_PROVIDER is read by the LangChain gateway.
NVIDIA_LLM_MODEL=nvidia/your-model-id
NVIDIA_LLM_JSON_MODEL=
NVIDIA_LLM_API_KEY=
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_JSON_MODEL=
GEMINI_LLM_API_KEY=
GEMINI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OLLAMA_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_LLM_JSON_MODEL=
OLLAMA_LLM_BASE_URL=http://ollama:11434
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=-1

OLLAMA_REQUIRE_GPU=true
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# First startup may include a large model download.
OLLAMA_START_TIMEOUT_SECONDS=1800

OPENAI_LLM_MODEL=
OPENAI_LLM_JSON_MODEL=
OPENAI_LLM_API_KEY=
OPENAI_LLM_BASE_URL=

OPENAI_COMPATIBLE_LLM_MODEL=
OPENAI_COMPATIBLE_LLM_JSON_MODEL=
OPENAI_COMPATIBLE_LLM_API_KEY=
OPENAI_COMPATIBLE_LLM_BASE_URL=

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_ALLOW_REMOTE_DOWNLOAD=true
EMBEDDING_CACHE_DIR=/app/data/model-cache/sentence-transformers
HF_TOKEN=
HF_HOME=/app/data/model-cache/huggingface
HUGGINGFACE_HUB_CACHE=/app/data/model-cache/huggingface
TRANSFORMERS_CACHE=/app/data/model-cache/huggingface

SOURCE_CACHE_DIR=/app/data/source-cache
ARTIFACT_DIR=/app/data/artifacts

ENABLE_GEEKSFORGEEKS=true
ENABLE_STACK_EXCHANGE=true
ENABLE_CODEFORCES=true
ENABLE_THE_ALGORITHMS=true
ENABLE_CP_ALGORITHMS=true

MAX_SOURCES_PER_JOB=10
MAX_CHUNKS_PER_SOURCE=8
MAX_REPAIR_ATTEMPTS=2

RAG_REUSE_ENABLED=true
RAG_EXTERNAL_DISCOVERY_ENABLED=true
RAG_PROMOTE_SUCCESSFUL_RUNS=true
RAG_EXACT_REVERIFY=true
RAG_MAX_LOCAL_CANDIDATES=10
RAG_MAX_EXTERNAL_CANDIDATES=10
RAG_EQUIVALENT_THRESHOLD=0.90
RAG_RELATED_THRESHOLD=0.72
RAG_MIN_ASSERTING_TESTS=8
RAG_SEMANTIC_WEIGHT=0.45
RAG_LEXICAL_WEIGHT=0.20
RAG_CONSTRAINT_WEIGHT=0.15
RAG_IO_WEIGHT=0.10
RAG_OBJECTIVE_WEIGHT=0.10
ENABLED_RETRIEVAL_ADAPTERS=stack_exchange,codeforces,curated_repository,user_url
STACK_EXCHANGE_KEY=
GITHUB_TOKEN=
EXTERNAL_FETCH_TIMEOUT_SECONDS=10
EXTERNAL_FETCH_MAX_BYTES=2000000
EXTERNAL_FETCH_MAX_REDIRECTS=3

POSTGRES_LOG_MIN_MESSAGES=info
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES_LOG_CONNECTIONS=on
POSTGRES_LOG_DISCONNECTIONS=on
POSTGRES_LOG_STATEMENT=none
QDRANT_LOG_LEVEL=info
