APP_ENV=local
VERBOSE_LOGGING=false
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10

DATABASE_URL=postgresql+psycopg://explainer:explainer@postgres:5432/programming_explainer

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=sources

SANDBOX_RUNNER_URL=http://sandbox-runner:8100
SLIDE_RENDERER_URL=http://slide-renderer:8200

MODEL_PROVIDER=ollama
MODEL_NAME_OR_PATH=qwen2.5-coder:7b
MODEL_DEVICE=auto
MODEL_MAX_NEW_TOKENS=2048
MODEL_TEMPERATURE=0.2
MODEL_LAZY_LOAD=false
MODEL_REQUIRE_CUDA=true
MODEL_ALLOW_CPU_OFFLOAD=true
MODEL_ALLOW_DISK_OFFLOAD=false
MODEL_CACHE_DIR=/app/data/model-cache/huggingface
MODEL_PERSISTENT_CACHE_ROOT=/app/data/model-cache
MODEL_REQUIRE_PERSISTENT_CACHE=true
MODEL_DOWNLOAD_ON_STARTUP=true
MODEL_LOCAL_FILES_ONLY=false
MODEL_QUANTIZATION=auto
MODEL_QUANTIZATION_FALLBACK=8bit
MODEL_LOAD_IN_4BIT=true
MODEL_LOAD_LOG_INTERVAL_SECONDS=30
MODEL_GPU_MEMORY_LIMIT=9GiB
MODEL_GPU_MEMORY_UTILIZATION=0.78
MODEL_KV_CACHE_VRAM_RESERVE=2.5GiB
MODEL_CPU_MEMORY_LIMIT=24GiB
MODEL_OFFLOAD_DIR=/app/data/model-cache/offload
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=-1
OLLAMA_REQUIRE_GPU=true
OLLAMA_PULL_ON_STARTUP=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
OLLAMA_LOAD_TIMEOUT_SECONDS=1800

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_ALLOW_REMOTE_DOWNLOAD=true
EMBEDDING_CACHE_DIR=/app/data/model-cache/sentence-transformers
HF_TOKEN=
HF_HOME=/app/data/model-cache/huggingface
HUGGINGFACE_HUB_CACHE=/app/data/model-cache/huggingface
TRANSFORMERS_CACHE=/app/data/model-cache/huggingface

SOURCE_CACHE_DIR=/app/data/source-cache
ARTIFACT_DIR=/app/data/artifacts

ENABLE_GEEKSFORGEEKS=true
ENABLE_STACK_EXCHANGE=true
ENABLE_CODEFORCES=true
ENABLE_THE_ALGORITHMS=true
ENABLE_CP_ALGORITHMS=true

MAX_SOURCES_PER_JOB=10
MAX_CHUNKS_PER_SOURCE=8
MAX_REPAIR_ATTEMPTS=2

POSTGRES_LOG_MIN_MESSAGES=info
POSTGRES_LOG_MIN_DURATION_STATEMENT=1000
POSTGRES_LOG_CONNECTIONS=on
POSTGRES_LOG_DISCONNECTIONS=on
POSTGRES_LOG_STATEMENT=none
QDRANT_LOG_LEVEL=info
